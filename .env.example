# Copy to .env and fill in. Never commit .env.
# Provider choice: jev|mock and cloudflare|mock. Mocks need no keys.
JUDGE=mock
SUMMARIZER=mock

# Jev (TypeSafe AI)
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1

# Cloudflare Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/meta/llama-3.1-8b-instruct
