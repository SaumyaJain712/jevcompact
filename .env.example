# Copy to .env and fill in. Never commit .env.
# Provider choice: jev|mock and cloudflare|mock. Mocks need no keys.
JUDGE=mock
SUMMARIZER=mock

# Jev (TypeSafe AI). Direct: https://api.typesafe.ai/v1 with a TypeSafe key.
# Via OpenRouter: JEV_BASE_URL=https://openrouter.ai/api/v1, JEV_MODEL=~typesafe/jev-latest
# and your OpenRouter key as JEV_API_KEY.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# Cloudflare Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/zai-org/glm-4.7-flash
