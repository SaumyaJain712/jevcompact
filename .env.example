# Copy to .env and fill in. Never commit .env.
# Provider choice. JUDGE=jev|cloudflare|mock (cloudflare = free Workers AI judge standing in
# for Jev, same account/token as the summarizer); SUMMARIZER=cloudflare|mock. Mocks need no keys.
# The evaluation (eval/run_eval.py --mode real) uses JUDGE=cloudflare unless JUDGE=jev.
JUDGE=mock
SUMMARIZER=mock

# Jev (TypeSafe AI). Direct: https://api.typesafe.ai/v1 with a TypeSafe key.
# Via OpenRouter: JEV_BASE_URL=https://openrouter.ai/api/v1, JEV_MODEL=~typesafe/jev-latest
# and your OpenRouter key as JEV_API_KEY.
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_MODEL=jev-latest

# Cloudflare Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_MODEL=@cf/zai-org/glm-4.7-flash
# Model for the Cloudflare judge (cheapest that returned strict JSON reliably; see PROGRESS.md)
CF_JUDGE_MODEL=@cf/ibm-granite/granite-4.0-h-micro
